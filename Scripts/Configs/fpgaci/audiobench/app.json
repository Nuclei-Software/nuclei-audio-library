{
    "run_config": {
        "target" : "hardware",
        "parsescript": "Scripts/parse.py",
        "hardware" : {
            "baudrate": 115200,
            "timeout": 60
        },
        "qemu": {
            "qemu32": "qemu-system-riscv32",
            "qemu64": "qemu-system-riscv64",
            "timeout": 60
        },
        "ncycm": {
            "timeout": 1200
        }
    },
    "copy_objects": true,
    "build_target": "clean all",
    "build_config": {
    },
    "parallel" : "-j",
    "checks": {
        "PASS": ["PASS"],
        "FAIL": ["MEPC", "FAIL"]
    },
    "appdirs": [
        "AMR-NB",
        "AMR-WB/amrwb_dec",
        "AMR-WB/amrwb_enc",
        "EVS",
        "EVRC",
        "MP3/minimp3"
    ],
    "appdirs_ignore": [
    ],
    "appconfig": {
        "EVS": {
            "build_config": { "DOWNLOAD": "ddr" },
            "run_config": {
                "hardware": {
                    "timeout": 360
                }
            }
        },
        "EVRC": {
            "run_config": {
                "hardware": {
                    "timeout": 900
                }
            }
        }
    }
}
